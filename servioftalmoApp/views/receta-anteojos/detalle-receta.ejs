<%- include("../partials/header") %>

    <div class="container mt-5">
        <h2>Detalle de Receta</h2>
        <% if (success_msg) { %>
            <div class="alert alert-success">
                <%= success_msg %>
            </div>
            <% } %>
                <p><strong>ID:</strong>
                    <%= Receta.Id_receta_anteojos %>
                </p>
                <p><strong>Fecha:</strong>
                    <%= Receta.Fecha %>
                </p>
                <p><strong>Nombre:</strong>
                    <%= Receta.Nombre %>
                </p>
                <p><strong>Estilo:</strong>
                    <%= Receta.Estilo %>
                </p>
                <p><strong>Observaciones:</strong>
                    <%= Receta.Observaciones %>
                </p>

                <a href="/receta-anteojos/list/<%= Receta.Id_paciente %>" class="btn btn-secondary">Volver</a>
    </div>

    <%- include("../partials/footer") %>